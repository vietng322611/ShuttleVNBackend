services:
  api:
    image: ${SHUTTLEVN_API_IMAGE:?Set SHUTTLEVN_API_IMAGE}
    container_name: shuttlevn-api
    restart: unless-stopped
    env_file:
      - ./api.env
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_URLS: http://+:8080
      Otel__Enabled: "true"
      Otel__Endpoint: http://tempo:4318/v1/traces
    # Bind on all interfaces so both Nginx (private IP) and the local
    # deploy health check (127.0.0.1) reach it. Reachability is gated by
    # the security group, not by the bind address.
    ports:
      - "8080:8080"
    networks:
      - default
      - shuttlevn

networks:
  # Shared with the observability stack so the API can push OTLP traces
  # to tempo:4318. /metrics stays on 8080 and is only reachable from the
  # private subnet; Nginx proxies /api/ alone.
  shuttlevn:
    external: true