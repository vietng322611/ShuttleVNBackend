global:
  scrape_interval: 15s

scrape_configs:
  - job_name: node-exporter
    static_configs:
      - targets:
          - "{{ hostvars['public_ec2'].private_ip }}:9100"
          - "{{ hostvars['private_ec2'].private_ip }}:9100"

  - job_name: cadvisor
    static_configs:
      - targets:
          - "{{ hostvars['public_ec2'].private_ip }}:8081"
          - "{{ hostvars['private_ec2'].private_ip }}:8081"

  # Application metrics. The API joins the shared shuttlevn network, so it
  # is scraped by container name instead of the host IP.
  - job_name: shuttlevn-api
    static_configs:
      - targets:
          - "shuttlevn-api:8080"